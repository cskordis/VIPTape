10 REM *** COMX-35 BASIC BENCHMARK / DEMO ***
20 REM *** VIPTAPE FIRMWARE LOAD/RUN TEST  ***
30 REM *** BASIC V1.03  -  PORTABLE SUBSET  ***
40 PRINT "COMX-35 BENCHMARK V1"
50 PRINT "===================="
60 PRINT
70 REM --- SECTION 1: EMPTY FOR/NEXT LOOP ---
80 PRINT "1. LOOP TEST"
90 LET K=0
100 FOR I=1 TO 1000
110 LET K=K+1
120 NEXT I
130 PRINT "   COUNT=";K
140 IF K=1000 THEN PRINT "   OK"
150 IF K<>1000 THEN PRINT "   FAIL"
160 PRINT
170 REM --- SECTION 2: INTEGER ARITHMETIC ---
180 PRINT "2. INTEGER MATH"
190 LET S=0
200 FOR I=1 TO 100
210 LET S=S+I
220 NEXT I
230 PRINT "   SUM 1..100=";S
240 IF S=5050 THEN PRINT "   OK"
250 IF S<>5050 THEN PRINT "   FAIL"
260 PRINT
270 REM --- SECTION 3: MULTIPLY / DIVIDE ---
280 PRINT "3. MUL/DIV TEST"
290 LET P=1
300 FOR I=1 TO 10
310 LET P=P*2
320 NEXT I
330 PRINT "   2^10=";P
340 IF P=1024 THEN PRINT "   OK"
350 IF P<>1024 THEN PRINT "   FAIL"
360 LET Q=P/4
370 PRINT "   /4 =";Q
380 IF Q=256 THEN PRINT "   OK"
390 IF Q<>256 THEN PRINT "   FAIL"
400 PRINT
410 REM --- SECTION 4: FLOATING POINT ---
420 PRINT "4. FLOAT TEST"
430 LET F=0
440 FOR I=1 TO 10
450 LET F=F+0.1
460 NEXT I
470 PRINT "   0.1 X10 =";F
480 LET A=22/7
490 PRINT "   22/7 =";A
500 PRINT
510 REM --- SECTION 5: NESTED LOOPS ---
520 PRINT "5. NESTED LOOP"
530 LET N=0
540 FOR I=1 TO 20
550 FOR J=1 TO 20
560 LET N=N+1
570 NEXT J
580 NEXT I
590 PRINT "   ITERATIONS=";N
600 IF N=400 THEN PRINT "   OK"
610 IF N<>400 THEN PRINT "   FAIL"
620 PRINT
630 REM --- SECTION 6: SUBROUTINE (GOSUB) ---
640 PRINT "6. GOSUB TEST"
650 LET T=0
660 FOR I=1 TO 5
670 LET X=I
680 GOSUB 900
690 LET T=T+Y
700 NEXT I
710 PRINT "   TOTAL=";T
720 IF T=55 THEN PRINT "   OK"
730 IF T<>55 THEN PRINT "   FAIL"
740 PRINT
750 REM --- SECTION 7: ARRAY / DIM ---
760 PRINT "7. ARRAY TEST"
770 DIM B(20)
780 FOR I=1 TO 20
790 LET B(I)=I*I
800 NEXT I
810 LET C=0
820 FOR I=1 TO 20
830 LET C=C+B(I)
840 NEXT I
850 PRINT "   SUM SQ=";C
860 IF C=2870 THEN PRINT "   OK"
870 IF C<>2870 THEN PRINT "   FAIL"
880 GOTO 950
890 REM --- SUBROUTINE: Y = X*2 ---
900 LET Y=X*2
910 RETURN
920 REM
930 REM
940 REM
950 PRINT
960 REM --- SECTION 8: STRING HANDLING ---
970 PRINT "8. STRING TEST"
980 LET A$="COMX"
990 LET B$="35"
1000 LET C$=A$+B$
1010 PRINT "   JOIN=";C$
1020 PRINT "   LEN =";LEN(C$)
1030 IF LEN(C$)=6 THEN PRINT "   OK"
1040 IF LEN(C$)<>6 THEN PRINT "   FAIL"
1050 PRINT
1060 REM --- SECTION 9: CHARACTER LOOP ---
1070 PRINT "9. CHAR TEST"
1080 FOR I=65 TO 90
1090 PRINT CHR$(I);
1100 NEXT I
1110 PRINT
1120 PRINT
1130 REM --- SECTION 10: COUNTDOWN ---
1140 PRINT "10. COUNTDOWN"
1150 FOR I=10 TO 1 STEP -1
1160 PRINT I;
1170 NEXT I
1180 PRINT
1190 PRINT
1200 REM --- DONE ---
1210 PRINT "===================="
1220 PRINT "BENCHMARK COMPLETE"
1230 PRINT "ALL SECTIONS RUN"
1240 END
